# Copy to .env, fill in, then: chmod 600 .env
# These credentials are only used by the one-time localKey helper.

HAIER_PHONE=
HAIER_PASSWORD=
HAIER_APP_SOURCE=app

# Optional. Leave HAIER_DEVICE_ID empty to let UDISCOVERY find the washer.
HAIER_DEVICE_ID=
HAIER_WASHER_IP=

# Cached access token path; the helper writes it with mode 0600.
HAIER_TOKEN_FILE=.haier_token

# Optional refresh-token flow (miniapp capture):
# HAIER_REFRESH_TOKEN=
# HAIER_CLIENT_ID=
# HAIER_APP_SOURCE=wxapp
